.installed.cfg
*.egg

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Temporary & Scratch Files
scratch/
tmp/
*.tmp
*.bak
*.log

# Raw Heavy Master Artworks (Retained locally on disk; excluded from git to prevent GitHub >100MB rejection and metadata leaks)
art/**/*.png
art/**/*.jpg
art/**/*.jpeg
art/**/*.tif
art/**/*.tiff
art/**/*.bmp
